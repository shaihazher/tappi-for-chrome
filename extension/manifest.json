{
  "manifest_version": 3,
  "name": "Tappi for Chrome — Open Shell",
  "version": "0.1.0",
  "description": "A sanitized extension shell for a multi-harness AI sidebar. Demo adapter only; no native host.",
  "minimum_chrome_version": "125",
  "permissions": ["sidePanel", "storage", "activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open the Tappi shell"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
